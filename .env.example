# Copie este arquivo para .env e preencha. O .env NAO vai para o Git.

# Login do portal da prefeitura (o portal simulado aceita o que estiver aqui)
PORTAL_USUARIO=robo.zelador
PORTAL_SENHA=defina-uma-senha-aqui
PORTAL_URL=http://127.0.0.1:8765
# 1 = o robo sobe o portal simulado sozinho | 0 = usar um portal que ja esta rodando
PORTAL_EMBUTIDO=1
# auto = tenta o Chrome e depois o Edge | chrome | edge
NAVEGADOR=auto
# 1 = mostra o navegador trabalhando | 0 = roda escondido
NAVEGADOR_VISIVEL=0

# "Sal" usado para gerar o pseudonimo do cidadao (troque por um texto aleatorio)
PSEUDONIMO_SAL=troque-por-um-texto-aleatorio

# API publica de clima (Open-Meteo, gratuita e sem chave)
CLIMA_API_URL=https://api.open-meteo.com/v1/forecast
CHUVA_FORTE_MM=10

# Resiliencia e IA
TIMEOUT_SEGUNDOS=8
MAX_TENTATIVAS=3
ESPERA_INICIAL=1
LIMIAR_CONFIANCA=0.55
TAMANHO_LOTE=500

# Opcional: caminho de um chromedriver ja instalado. Deixe vazio para o
# Selenium Manager baixar o driver certo sozinho (precisa de internet na 1a vez).
CHROMEDRIVER_PATH=

# Opcional: modelo .joblib de outra disciplina (scikit-learn, com predict_proba
# e as mesmas categorias). Vazio = usa o modelo proprio do ZelaBot.
MODELO_EXTERNO=
